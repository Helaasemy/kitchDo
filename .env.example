EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional server-only (never ship in the app bundle):
# SUPABASE_SERVICE_ROLE_KEY=...

EXPO_PUBLIC_SANITY_PROJECT_ID=qxq0r1rb
EXPO_PUBLIC_SANITY_DATASET=production
EXPO_PUBLIC_SANITY_API_VERSION=2025-02-19
# CLI/import only — never EXPO_PUBLIC, never commit:
# SANITY_API_WRITE_TOKEN=...

# Local Simulator: Test Store public key (test_…). Release/EAS: Apple public key (appl_…).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Apple App Store public key (appl_…). Used in release builds.
# EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
# Debug/simulator — Test Store public key (test_…). Never ship in release:
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=
# CLI/server only — never EXPO_PUBLIC, never commit:
# REVENUECAT_SECRET_API_KEY=sk_...
